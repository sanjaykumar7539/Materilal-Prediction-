OWNLLM_MODEL_PATH=./models/ownllm.pt
TOKENIZER_PATH=./models/tokenizer.json
DEVICE=cpu
MAX_SEQ_LENGTH=4096
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOCAL_VECTOR_DB_PATH=./data/vector_store
LOCAL_KAG_DB_PATH=./data/kag.sqlite
LOCAL_CACHE_DB_PATH=./data/cache.sqlite
REDIS_URL=redis://127.0.0.1:6379/0
RPM=30
RATE_WINDOW=60
MAX_CONCURRENCY=4
OWNLLM_OFFLINE=0
LOG_LEVEL=INFO
OWNLLM_API=http://127.0.0.1:8000/generate
OWNLLM_DOMAIN=materials
OWNLLM_DOMAINS_DIR=./domains
OWNLLM_MATERIALS_KB=./domains/materials/verified_records.json
OWNLLM_MATERIALS_FEEDBACK=./data/materials_feedback.sqlite3
# Empty keys permit direct loopback clients only; never trust X-Forwarded-For.
# Set a JSON mapping of strong local API keys to reader, writer, or admin roles.
OWNLLM_API_KEYS={}
OWNLLM_REQUIRE_TLS=0
OWNLLM_MAX_REQUEST_BYTES=200000
OWNLLM_MAX_RESPONSE_BYTES=1000000
OWNLLM_TOKEN_BUDGET_PER_MINUTE=100000
OWNLLM_MAX_PENDING=16
OWNLLM_QUEUE_TIMEOUT=5
OWNLLM_REQUEST_TIMEOUT=120
# Optional JSON array index inside this root; each document needs an explicit ACL.
OWNLLM_KNOWLEDGE_ROOT=./data
OWNLLM_KNOWLEDGE_INDEX=
